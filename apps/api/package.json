{
  "name": "@owl-mentors/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --env-file ../../.env --watch src/server.ts",
    "build": "bun --env-file ../../.env build src/server.ts --outdir dist --target bun",
    "start": "bun --env-file ../../.env dist/server.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "seed:admin": "bun --env-file ../../.env src/scripts/seed-admin.ts",
    "seed:mentors": "bun --env-file ../../.env src/scripts/seed-mentors.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/lib-storage": "^3.995.0",
    "@google-cloud/documentai": "^9.6.0",
    "@owl-mentors/database": "workspace:*",
    "@owl-mentors/llm": "workspace:*",
    "@owl-mentors/types": "workspace:*",
    "@owl-mentors/utils": "workspace:*",
    "@types/nodemailer": "^7.0.11",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.5.0",
    "googleapis": "^144.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "openai": "^4.0.0",
    "pdf-parse": "^2.4.5",
    "livekit-server-sdk": "^2.15.3",
    "stripe": "^17.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.5",
    "@types/pdf-parse": "^1.1.5",
    "typescript": "^5.3.3"
  }
}