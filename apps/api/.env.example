# Server
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mentor-app
MONGODB_DB_NAME=mentor-app

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# LLM
OPENROUTER_API_KEY=your_openrouter_key_here
GROQ_API_KEY=your_groq_key_here
LLM_PROVIDER=openrouter

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Email (Nodemailer) — for OTP delivery
# Leave blank in development to use console logging fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=OWLMentors <noreply@owlmentors.com>

# Admin notifications (email sent when a new mentor signs up)
ADMIN_NOTIFICATION_EMAIL=indianshahishere@gmail.com
ADMIN_URL=https://owlmentors.com/admin

# Cloudinary — profile photo & image uploads
# https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudflare R2 — certifications & intro videos
# Cloudflare Dashboard → R2 → Manage R2 API tokens
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=owlmentors
R2_PUBLIC_URL=https://your-public-bucket-url.r2.dev

# Google Calendar Integration
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback

# Frontend URL (used for OAuth redirects back to the app)
FRONTEND_URL=http://localhost:3000

# Daily.co — video rooms + recording webhook
# https://dashboard.daily.co → Developers → API keys
DAILY_API_KEY=           # Daily REST API key
DAILY_WEBHOOK_SECRET=    # HMAC secret from Daily dashboard → Webhooks

# Stripe — payment processing
# https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...   # Secret key (never expose client-side)
STRIPE_WEBHOOK_SECRET=whsec_... # From Stripe → Webhooks (optional, for webhook validation)

# Voyage AI — text embeddings for semantic mentor search (free tier)
# https://www.voyageai.com → Dashboard → API Keys
VOYAGE_API_KEY=          # Used for mentor profile embeddings
EMBEDDING_PROVIDER=voyage

# Note: Whisper transcription uses GROQ_API_KEY (already set above)
