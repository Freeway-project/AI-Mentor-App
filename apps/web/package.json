{
  "name": "@owl-mentors/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development bun --env-file ../../.env next dev --port 3000",
    "build": "NODE_ENV=production bun --env-file ../../.env next build",
    "start": "NODE_ENV=production bun --env-file ../../.env next start --port 3000",
    "type-check": "tsc --noEmit",
    "lint": "next lint",
    "clean": "rm -rf .next out",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
