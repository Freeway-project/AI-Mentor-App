# MongoDB
MONGODB_URI=mongodb://localhost:27017/mentor-app
MONGODB_DB_NAME=mentor-app

# LLM Services
OPENROUTER_API_KEY=your_openrouter_key_here
GROQ_API_KEY=your_groq_key_here          # Also used for Whisper transcription
LLM_PROVIDER=openrouter

# Embeddings (semantic mentor search)
VOYAGE_API_KEY=your_voyage_api_key_here  # https://www.voyageai.com
EMBEDDING_PROVIDER=voyage

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Document AI
DOCUMENT_AI_PROJECT_ID=
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
# Set GOOGLE_APPLICATION_CREDENTIALS in your shell or deployment environment
# to the path of your Google Cloud service account JSON key.

# Server
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000

# Environment
NODE_ENV=development

# Better Stack Logging (optional)
# https://betterstack.com/logs
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_URL=https://in.logs.betterstack.com
BETTERSTACK_SERVICE=owl-mentors-api
BETTERSTACK_MIN_LEVEL=info
