# ── Copy this file to docker/.env and fill in your values ──────────────────

# JWT — use a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=change_me_use_a_strong_random_secret
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Browser-facing API URL (what the user's browser will call)
# Local:      http://localhost:3001
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# LLM providers (Groq is primary, OpenRouter is fallback)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Embeddings (Voyage AI)
VOYAGE_API_KEY=
EMBEDDING_PROVIDER=voyage

# Google OAuth
GOOGLE_CLIENT_ID=

# Frontend & admin URLs (used for OAuth redirects and email links)
FRONTEND_URL=https://yourdomain.com
ADMIN_URL=https://yourdomain.com/admin
ADMIN_NOTIFICATION_EMAIL=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# LiveKit
# Production: wss://livekit.yourdomain.com  (nginx proxies 443 → 7880)
# Local dev:  ws://livekit:7880
LIVEKIT_URL=wss://livekit.yourdomain.com
LIVEKIT_API_KEY=change_me_strong_api_key
LIVEKIT_API_SECRET=change_me_strong_secret_min_32_chars
# Public HTTPS URL of the API — LiveKit will POST webhooks here
API_WEBHOOK_URL=https://api.yourdomain.com

# MinIO (S3-compatible storage for recordings)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=owl-mentor-recordings
MINIO_REGION=us-east-1
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000

# Egress storage (LiveKit uses S3-compatible config)
AWS_S3_BUCKET=${MINIO_BUCKET}
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
AWS_REGION=${MINIO_REGION}
AWS_S3_ENDPOINT=${MINIO_ENDPOINT}
AWS_S3_FORCE_PATH_STYLE=true

# ── Better Stack ─────────────────────────────────────────────────────────────
# Create two Sources in BetterStack → Logs → Sources:
#   1. "owl-mentors-logs"    → paste token below as BETTERSTACK_LOGS_TOKEN
#   2. "owl-mentors-metrics" → paste token below as BETTERSTACK_METRICS_TOKEN
# The API also uses BETTERSTACK_SOURCE_TOKEN for its own structured logs (same as LOGS token).

# API structured logs (Winston → BetterStack)
BETTERSTACK_SOURCE_TOKEN=your_logs_source_token_here
BETTERSTACK_INGESTING_URL=https://in.logs.betterstack.com
BETTERSTACK_SERVICE=owl-mentors-api
BETTERSTACK_MIN_LEVEL=info

# Vector: container stdout/stderr → BetterStack (use same token as SOURCE_TOKEN)
BETTERSTACK_LOGS_TOKEN=your_logs_source_token_here

# Vector: VPS CPU / RAM / disk / network → BetterStack (separate source for clean dashboards)
BETTERSTACK_METRICS_TOKEN=your_metrics_source_token_here
